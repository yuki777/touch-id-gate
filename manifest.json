{
  "manifest_version": 3,
  "name": "Touch ID Gate",
  "version": "0.4.0",
  "description": "指定した URL を開く前に Touch ID を要求する",
  "minimum_chrome_version": "122",
  "key": "",
  "permissions": ["declarativeNetRequest", "webNavigation", "storage", "alarms", "activeTab"],
  "action": { "default_title": "このタブを Touch ID で解除する" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html"
}
